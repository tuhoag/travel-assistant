OPENROUTER_API_KEY=

# Required for chat generation via Groq (get one at https://console.groq.com/keys).
# Falls back to OPENROUTER_API_KEY if unset.
GROQ_API_KEY=

# Optional: OpenAI-compatible embedding endpoint. Defaults to OpenRouter.
OPENROUTER_BASE_URL=

# Optional: embedding model to use. Defaults to nvidia/nemotron-3-embed-1b:free.
EMBEDDING_MODEL=

# Optional: OpenAI-compatible chat endpoint. Defaults to Groq.
CHAT_BASE_URL=

# Optional: chat model to use. Defaults to openai/gpt-oss-120b (Groq).
CHAT_MODEL=

# Optional: Qdrant connection URL. Defaults to http://localhost:6333.
QDRANT_URL=

# Optional: Qdrant collection name. Defaults to cities.
QDRANT_COLLECTION=

# Optional: local Qdrant storage path (used by docker-compose volume). Defaults to db/qdrant_storage.
QDRANT_INDEX_DIR=
