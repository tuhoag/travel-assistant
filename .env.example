OPENROUTER_API_KEY=

# Required for chat generation via Groq (get one at https://console.groq.com/keys).
# Falls back to OPENROUTER_API_KEY if unset. Ignored when ENVIRONMENT=dev.
GROQ_API_KEY=

# Optional: embedding model to use (runs locally via fastembed, no API key needed).
# Defaults to BAAI/bge-small-en-v1.5.
EMBEDDING_MODEL=

# Optional: set to "dev" to chat against a local OpenAI-compatible server
# (e.g. vLLM, Docker Model Runner) at CHAT_BASE_URL instead of Groq/OpenRouter.
ENVIRONMENT=

# Optional: OpenAI-compatible chat endpoint. Defaults to http://localhost:8080/v1.
CHAT_BASE_URL=

# Optional: chat model to use. Defaults to Qwen/Qwen2.5-3B-Instruct.
CHAT_MODEL=

# Optional: Qdrant connection URL. Defaults to http://localhost:6333.
QDRANT_URL=

# Optional: local Qdrant storage path (used by docker-compose volume). Defaults to db/qdrant_storage.
QDRANT_INDEX_DIR=
